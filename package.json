{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Professional portfolio with automated validation",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "html-validate index.html resume.html 'cases/**/*.html' 'pt/**/*.html' 'es/**/*.html'",
    "lint:css": "stylelint 'css/*.css' 'cases/**/*.css'",
    "lint:js": "eslint '*.js'",
    "lint:fix": "npm run lint:css -- --fix && npm run lint:js -- --fix",
    "build:css": "node scripts/build-css.js",
    "build:css:check": "node scripts/build-css.js --check",
    "build:i18n": "node scripts/build-i18n.js",
    "build:i18n:check": "node scripts/build-i18n.js --check",
    "validate": "npm run build:css:check && npm run build:visuals:check && npm run build:i18n:check && npm run lint",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test": "npm run validate && npm run test:python && npm run check:sample && npm run test:e2e",
    "og:generate": "node scripts/generate-og-image.js",
    "og:generate:case-vllm": "node scripts/generate-og-case-vllm.js",
    "og:generate:case-gke": "node scripts/generate-og-case-gke.js",
    "prepare": "husky",
    "build:visuals": "node scripts/build-case-visuals.js",
    "build:visuals:check": "node scripts/build-case-visuals.js --check",
    "resume:pdf": "node scripts/generate-resume-pdf.js",
    "test:python": "python3 -m unittest discover -s examples/inference-fallback -p 'test_*.py' -v",
    "build:sample": "python3 scripts/build-code-sample.py",
    "check:sample": "python3 scripts/build-code-sample.py --check"
  },
  "lint-staged": {
    "**/*.html": "html-validate",
    "css/*.css": [
      "stylelint --fix",
      "node scripts/build-css.js",
      "git add styles.css"
    ],
    "**/*.js": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vitorspk/portfolio.git"
  },
  "author": "Vitor Schiavo",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.6.0",
    "globals": "^16.5.0",
    "html-validate": "^11.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "serve": "^14.2.6",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^36.0.0"
  }
}
